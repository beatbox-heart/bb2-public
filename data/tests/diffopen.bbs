// The diff device restricted to a part of the tissue (x<=xb) with isolated=0 is connected
// to the tissue beyond its border, so must give in its space exactly the same laplacian
// as diffopenref.bbs, where diff runs on the whole tissue. This requires the diff tensor
// beyond the border, here with anisotropic and variable diffusivity.
// In MPI, decomposed so that some processes have no points of the device.
def str out [1];
<diffsub.par>
state xmax=nx+2 ymax=ny+2 zmax=1 vmax=5 anisotropy=1 pgm={
  geom0=gt(hypot(x-15,y-17),5);
  geom1=cos(0.05*x+0.03*y); geom2=sin(0.05*x+0.03*y); geom3=0;
};
<diffsub.ini>
diff v0=0 v1=1 hx=hx ht=0 Dl=~1+0.3*sin(0.1*x) Dt=0.2 d0=2 d1=4 isolated=0 x1=xb;
dump when=end x1=xb v0=0 v1=1 file=[out];
stop when=end;
end;

// The diff device restricted to a part of the tissue (x<=xb) must treat
// the border of its space as a no-flux boundary, i.e. give exactly the
// same result as diffsubref.bbs, where the tissue itself is cut at x=xb.
// Anisotropic, with variable diffusivity and weights recomputed at every step.
// In MPI, decomposed so that some processes have no points of the device.
def str out [1];
<diffsub.par>
state xmax=nx+2 ymax=ny+2 zmax=1 vmax=5 anisotropy=1 pgm={
  geom0=gt(hypot(x-15,y-17),5);
  geom1=cos(0.05*x+0.03*y); geom2=sin(0.05*x+0.03*y); geom3=0;
};
<diffsub.ini>
diff v0=0 v1=1 hx=hx ht=ht Dl=~1+0.3*sin(0.1*x) Dt=0.2 d0=2 d1=4 reweight=always x1=xb;
<diffsub.end>
